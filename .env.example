# Mesmos valores do V1 (mesmo projeto Supabase). As tabelas do V2 ficam no
# schema "v2" do Postgres, separadas das do V1.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Chave de ADMINISTRADOR (service_role), só para excluir o login quando o aluno
# exclui a conta (Perfil → Excluir minha conta). Fica SÓ aqui, no servidor;
# nunca no navegador. Sem ela, a exclusão automática fica desligada (com aviso).
SUPABASE_SERVICE_ROLE_KEY=

# Postgres do Supabase via Transaction pooler (porta 6543) — nunca a conexão
# direta em serverless.
SQL_HOST=
SQL_PORT=6543
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=postgres
# Opcional (recomendado): certificado do Supabase (Project Settings → Database
# → SSL Configuration → Download certificate), colado inteiro. Com ele o
# servidor confere que está falando com o banco certo.
SQL_CA_CERT=

# Correção de redação (etapa 4). Sem a chave, a tela avisa que a correção
# está desligada. Modelo padrão: gpt-4.1-mini.
OPENAI_API_KEY=
OPENAI_MODEL=

# Pagamentos (etapa 5) — Mercado Pago, Checkout Pro. Token TEST-... abre o
# ambiente de testes. O segredo do webhook fica em Suas integrações →
# Webhooks (URL: https://SEU_DOMINIO/api/pagamentos/webhook, evento Pagamentos).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Endereço público do app (volta do checkout e URL do webhook).
APP_BASE_URL=

# CAPTCHA (Cloudflare Turnstile) no login, cadastro e "esqueci a senha".
# Chave PÚBLICA (site key). A chave secreta vai só no painel do Supabase
# (Authentication → Attack Protection). Sem esta variável, o CAPTCHA fica
# desligado. Ordem certa: docs/seguranca.md.
TURNSTILE_SITE_KEY=
# Chave SECRETA do mesmo widget (Cloudflare → Turnstile → Settings). Usada só
# no servidor (server/turnstile.ts) para conferir o CAPTCHA do cadastro, do
# "esqueci a senha", da lista de contatos e de toda escrita do jogo.
# Em produção é obrigatória: sem ela, essas ações são recusadas.
TURNSTILE_SECRET_KEY=
# Sites aceitos no token além de aprovatico.com.br e www.aprovatico.com.br
# (opcional). Nas prévias da Vercel, o endereço da prévia entra sozinho.
TURNSTILE_HOSTNAMES=

# Medição (Meta). Temporário: sem esta variável, o site mede todos os visitantes,
# sem aviso de cookies. Com VITE_EXIGIR_CONSENTIMENTO=true, volta o aviso e nada é
# medido antes do aceite (LGPD). Variável de build: mudar exige novo deploy.
VITE_EXIGIR_CONSENTIMENTO=
