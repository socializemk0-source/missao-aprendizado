# Mesmos valores do V1 (mesmo projeto Supabase). As tabelas do V2 ficam no
# schema "v2" do Postgres, separadas das do V1.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Postgres do Supabase via Transaction pooler (porta 6543) — nunca a conexão
# direta em serverless.
SQL_HOST=
SQL_PORT=6543
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=postgres

# Correção de redação (etapa 4). Sem a chave, a tela avisa que a correção
# está desligada. Modelo padrão: gpt-4.1-mini.
OPENAI_API_KEY=
OPENAI_MODEL=

# Pagamentos (etapa 5) — Mercado Pago, Checkout Pro. Token TEST-... abre o
# ambiente de testes. O segredo do webhook fica em Suas integrações →
# Webhooks (URL: https://SEU_DOMINIO/api/pagamentos/webhook, evento Pagamentos).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Endereço público do app (volta do checkout e URL do webhook).
APP_BASE_URL=
